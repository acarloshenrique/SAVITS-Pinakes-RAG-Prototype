<https://doi.org/10.1234/pinakes.2024.001> a bibo:AcademicArticle,
        bibo:Document ;
    dc:creator <https://orcid.org/0000-0001-2345-6789>,
        <https://orcid.org/0000-0002-9876-5432> ;
    dc:date "2024" ;
    dc:description "Este artigo investiga a aplicação de redes neurais convolucionais para classificação automatizada de espécies da fauna amazônica a partir de imagens de armadilhas fotográficas. O método proposto alcança acurácia de 94,3% em um conjunto de dados com 150 espécies."@pt ;
